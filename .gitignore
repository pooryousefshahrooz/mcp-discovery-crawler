# crawl output (large, regenerated by discover.py)
data/

# directory listings and merged pools (regenerated by directories/collect.py + merge.py;
# some endpoint URLs carry third-party API keys, so never commit them)
directories/raw/
directories/logs/
directories/endpoints.csv
directories/listings_all.csv

# analysis and probe outputs (regenerated; contain third-party server content)
analysis/out/
ad_probe/results/

# research notes (unpublished findings)
analysis/*_findings.md

__pycache__/
*.pyc
.venv/
*.log
.DS_Store

# other-protocol scanners (regenerated; contain third-party content)
a2a_data/
sse_data/
x402_data/
longitudinal_mcp/
longitudinal_a2a/
longitudinal_logs/
ad_probe/results/

# full crawl output (2.3GB, regenerated; per-endpoint data may carry session ids/tokens)
fresh_measurement/

# ad-metadata / ad-provenance pipelines: per-response outputs are large and hold
# third-party server content (regenerated by run_all.sh); keep only aggregate tables
analysis/ad_metadata/out/responses.jsonl
analysis/ad_metadata/out/findings.jsonl
analysis/ad_metadata/out/findings_accepted.csv
analysis/ad_provenance/out/*
!analysis/ad_provenance/out/final_codes.json
analysis/*/*_FINDINGS.md
